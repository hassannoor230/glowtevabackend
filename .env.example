PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=<replace-with-at-least-32-random-characters>
JWT_REFRESH_SECRET=<replace-with-at-least-32-random-characters>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STRIPE_SECRET_KEY=<replace-with-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<replace-with-stripe-webhook-secret>
CLOUDINARY_CLOUD_NAME=<replace-with-cloud-name>
CLOUDINARY_API_KEY=<replace-with-api-key>
CLOUDINARY_API_SECRET=<replace-with-api-secret>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<replace-with-email>
SMTP_PASS=<replace-with-app-password>
SMTP_FROM=noreply@glowteva.com
CLIENT_URL=http://localhost:3000
FRONTEND_URL=
CORS_ORIGIN=
ADMIN_EMAIL=admin@glowteva.com
ADMIN_PASSWORD=<replace-with-a-strong-password>
